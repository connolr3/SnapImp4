#install.packages("readxl")   # run once
library(readxl)
data <- read_excel("C:/Users/CONNOLR3/DOWNLOADS/test.xlsx")
library(tidyverse)
library(ggpubr)
library(tidyr)
library(dplyr)
library(ggplot2)
library(rstatix)
res.aov <- anova_test(data = data, dv = score, wid = id, within = time)
get_anova_table(res.aov)
data <- read_excel("C:/Users/CONNOLR3/DOWNLOADS/test.xlsx")
res.aov <- anova_test(data = data, dv = score, wid = id, within = time)
View(data)
data$p_reg <-data$`PSIAL REGULAR`
data$p_snap <-data$`PSIAL SNAP`
long <- data %>%
gather(key = "id", value = "score", , t2, t3) %>%
convert_as_factor(id, time)
shapiro.test(data$`PSIAL SNAP`)
shapiro.test(data$`PSIAL REGULAR`)
diff <- data$`PSIAL SNAP` - data$`PSIAL REGULAR`
shapiro.test(diff)
shapiro.test(data$adj_snap...21)
data_long <- data %>%
rename(first_block = `first block`) %>%
pivot_longer(
cols = c(`PSIAL SNAP`, `PSIAL REGULAR`),
names_to = "condition",
values_to = "PSIAL"
) %>%
mutate(
condition = recode(
condition,
`PSIAL SNAP` = "SNAP",
`PSIAL REGULAR` = "REGULAR"
),
condition = factor(condition, levels = c("SNAP", "REGULAR")),
first_block = factor(first_block)
)
data_long %>%
group_by(ID) %>%
identify_outliers(PSIAL)
res.aov <- anova_test(data = data_long, dv = PSIAL, wid = ID, within = condition,between='first_block')
get_anova_table(res.aov)
res.aov
summary(res.aov)
#install.packages("readxl")   # run once
library(readxl)
data <- read_excel("C:/Users/CONNOLR3/DOWNLOADS/test.xlsx")
library(tidyverse)
library(ggpubr)
library(tidyr)
library(dplyr)
library(rstatix)
data$p_reg <data$`PSIAL REGULAR`
data$p_snap <data$`PSIAL SNAP`
wilcox.test(data$adj_snap_av, data$adj_reg_av, paired=TRUE)
#p=0.2
wilcox.test(
data$adj_snap_av,   # adjusted teleport condition
data$adj_reg_av,    # baseline condition
paired = TRUE,
alternative = "less",
exact = FALSE
)
data$adj_snap_av
wilcox.test(
data$adj_snap_av,   # adjusted teleport condition
data$adj_reg_av,    # baseline condition
paired = TRUE,
alternative = "less",
exact = FALSE
)
#Paired Samples T-TEST TO check for different in participants' preferred IPD and average IPD in baseline
data$IPDDIFFERENCE<-data$`IPD Preference...19`-data$falseipd
shapiro.test(data$IPDDIFFERENCE)
shapiro.test(pnorm(30,0,1))
(pnorm(30,0,1))
(qnorm(30,0,1))
(rnorm(30,0,1))
shapiro.test(rnorm(30,0,1))
shapiro.test(rnorm(100,0,1))
shapiro.test(rpois(100,0,1))
shapiro.test(rpois(100,0))
rpois(4)
rpois(40,4)
shapiro.test(rpois(100,100))
shapiro.test(rpois(1000,100))
shapiro.test(rpois(10000,100))
shapiro.test(rpois(5000,100))
shapiro.test(rnorm(1000,0,1))
t.test(data$`IPD Preference...19`, data$falseipd, paired = TRUE, alternative = "two.sided")
t.test(data$`IPD Preference...19`, data$falseipd,
paired = TRUE,
alternative = "less")
data$IPDDIFFERENCE<-data$`IPD Preference...19`-data$falseipd
shapiro.test(data$IPDDIFFERENCE)
t.test(data$`IPD Preference...19`, data$falseipd, paired = TRUE, alternative = "two.sided")
t.test(data$falseipd,data$`IPD Preference...19`,
paired = TRUE,
alternative = "less")
